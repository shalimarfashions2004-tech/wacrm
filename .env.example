# Safe baseline for Shalimar Connect development. Prefer .env.local for
# local values; never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-placeholder
ENCRYPTION_KEY=replace-with-64-hex-characters
META_APP_SECRET=server-only-placeholder
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_LOCALE=en
MESSAGING_DELIVERY_MODE=dry-run
MESSAGING_LIVE_APPROVED=false
# Human replies only, inside a verified customer's 24-hour service window.
# Exact provider IDs must match the saved connection. No campaign/worker access.
MESSAGING_INBOX_REPLIES_APPROVED=false
MESSAGING_INBOX_PHONE_NUMBER_ID=
MESSAGING_INBOX_WABA_ID=
# Optional owner-approved manual inbox test; blank means disabled.
# One attempt per approval, exact fixed test text, recent inbound required.
# Configure privately on the server; never prefix these with NEXT_PUBLIC_.
MESSAGING_TEST_RECIPIENT=
MESSAGING_TEST_PHONE_NUMBER_ID=
MESSAGING_TEST_EXPIRES_AT=
MESSAGING_PROVIDER=meta-cloud
DEFAULT_COUNTRY_CODE=91
MONTHLY_MESSAGE_BUDGET_INR=10000
DAILY_MESSAGE_LIMIT=1000
